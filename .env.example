# ============================================================
# 🧠 LINKEDIN NEURAL SCOUT — Environment Variables
# ============================================================
# Copy this file to .env and fill in your keys:
# cp .env.example .env
# ============================================================

# --- 1. LinkedIn Session ---
# Paste your `li_at` cookie value from browser developer tools
LINKEDIN_COOKIE=your_linkedin_li_at_cookie_here
HEADLESS=true

# --- 2. AI Model Provider Keys ---
# Primary inference engine (Groq - Llama 3.3 70B / DeepSeek R1)
GROQ_API_KEY=your_groq_api_key_here

# Visual & Reasoning engine (Google Gemini 2.0 Flash / 2.5)
GEMINI_API_KEY=your_gemini_api_key_here

# Knowledge Graph Embeddings (Cohere Multilingual v3)
COHERE_API_KEY=your_cohere_api_key_here

# Optional: DeepSeek / OpenRouter / Ollama Local AI support
DEEPSEEK_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- 3. Database & Storage ---
# PostgreSQL Local Database with pgvector (100% offline & local inside Docker)
DATABASE_URL=postgresql://neural:neural@localhost:5432/neural_db

# Qdrant Vector DB host (default inside Docker compose)
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# --- 4. Service Ports ---
BACKEND_PORT=3001
AI_ENGINE_PORT=8001
FRONTEND_PORT=5173

# --- 5. Cache & Performance (Optional) ---
UV_CACHE_PATH=
PLAYWRIGHT_CACHE_PATH=
