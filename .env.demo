# ============================================================
# 🎮 DEMO MODE — Run Neural Scout without API keys
# Usage: docker compose --env-file .env.demo up
# ============================================================

DEMO_MODE=true
NODE_ENV=demo

# Demo keys — no real API calls are made
GROQ_API_KEY=demo_mode_no_key_required
GEMINI_API_KEY=demo_mode_no_key_required

# Infrastructure (same as live mode)
DATABASE_URL=postgresql://neural:neural@postgres:5432/neural_db
REDIS_URL=redis://redis:6379
VAULT_SECRET=demo_vault_secret_32_chars_long!!

# Ports
BACKEND_PORT=3004
AI_ENGINE_PORT=8001
FRONTEND_PORT=5173

# Feature flags
USE_QDRANT=false
USE_PHOENIX=false
USE_OLLAMA=false

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
